{
  "name": "tokengo",
  "version": "0.4.0",
  "description": "Local achievements for Codex. An offline cabinet, activity statistics and shareable cards.",
  "type": "module",
  "main": "src/desktop/main.cjs",
  "license": "MIT",
  "author": "DragonYJ",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "scan": "node src/cli.mjs scan",
    "watch": "node src/cli.mjs watch",
    "build": "electron-builder --publish never",
    "build:dir": "electron-builder --dir",
    "site": "node scripts/build-site.mjs",
    "test:ui": "npm run site && node scripts/ui-smoke.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "test:mcp": "node scripts/mcp-smoke.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.56.1",
    "electron": "45.3.4",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1"
  },
  "build": {
    "appId": "io.tokengo.desktop",
    "productName": "TokenGo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "packs/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "community/rates.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "icon": "assets/icon.png"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DragonYJ/TokenGo.git"
  },
  "homepage": "https://dragonyj.github.io/TokenGo/",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "tokengo": "src/cli.mjs"
  },
  "files": [
    "src/",
    "packs/",
    "assets/",
    "community/rates.json",
    "LICENSE",
    "README.md",
    "plugins/tokengo/",
    ".agents/plugins/marketplace.json"
  ]
}
